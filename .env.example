# PostgreSQL (Neon, Supabase, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sms?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Cloudinary (all images: logo, student/staff photos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="sms_unsigned"

# Seed admin (optional overrides)
SEED_ADMIN_EMAIL="admin@school.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_PHONE=""
