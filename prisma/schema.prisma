generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
  GRADUATED
  ALUMNI
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  UNCLE
  AUNT
  GUARDIAN
  OTHER
}

enum EnrollmentStatus {
  ENROLLED
  PROMOTED
  REPEATED
  TRANSFERRED
  CONTINUED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CalendarDayType {
  CLOSED
  OPEN
}

enum FeeInvoiceStatus {
  OPEN
  PARTIAL
  PAID
  WAIVED
}

enum FeePaymentMethod {
  CASH
  MOMO
  BANK
  OTHER
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions Position[]
  staff     Staff[]
}

model Position {
  id           String      @id @default(cuid())
  name         String
  description  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  staff Staff[]

  @@unique([name, departmentId])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  imageUrl     String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff         Staff?
  guardian      Guardian?
  student       Student?
  announcements Announcement[]
  auditLogs     AuditLog[]
  notifications Notification[]
  feePayments   FeePayment[]

  @@index([roleId])
}

model SchoolSettings {
  id             String   @id @default(cuid())
  name           String
  shortName      String?
  logoUrl        String?
  address        String?
  phone          String?
  email          String?
  primaryColor   String   @default("#2563EB")
  secondaryColor String   @default("#1E40AF")
  accentColor    String   @default("#F59E0B")
  defaultTheme   String   @default("system")
  /// Comma-separated JS weekday numbers that are non-school days. Default Sun+Sat = "0,6"
  weekendClosed  String   @default("0,6")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Staff {
  id           String       @id @default(cuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  staffNo      String       @unique
  firstName    String
  lastName     String
  otherNames   String?
  gender       Gender?
  phone        String?
  email        String?
  photoUrl     String?
  hireDate     DateTime?
  status       StaffStatus  @default(ACTIVE)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  classSections       ClassSection[]      @relation("ClassTeacher")
  teacherSubjects     TeacherSubject[]
  attendanceMarked    AttendanceRecord[]  @relation("AttendanceMarkedBy")
  timetableSlots      TimetableSlot[]
}

model Guardian {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName   String
  phone      String?
  email      String?
  occupation String?
  address    String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  students StudentGuardian[]
}

model Student {
  id                    String         @id @default(cuid())
  userId                String?        @unique
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNo           String         @unique
  firstName             String
  lastName              String
  otherNames            String?
  gender                Gender?
  dateOfBirth           DateTime?
  admissionDate         DateTime?
  status                StudentStatus  @default(ACTIVE)
  currentClassSectionId String?
  currentClassSection   ClassSection?  @relation("CurrentClass", fields: [currentClassSectionId], references: [id], onDelete: SetNull)
  photoUrl              String?
  bloodGroup            String?
  allergies             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  guardians    StudentGuardian[]
  enrollments  Enrollment[]
  attendance   AttendanceRecord[]
  marks        StudentMark[]
  reportCards  ReportCard[]
  feeInvoices  FeeInvoice[]

  @@index([lastName, firstName])
  @@index([status])
}

model StudentGuardian {
  id           String               @id @default(cuid())
  studentId    String
  guardianId   String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship @default(GUARDIAN)
  isPrimary    Boolean              @default(false)
  canPickup    Boolean              @default(true)

  @@unique([studentId, guardianId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms              Term[]
  classSections      ClassSection[]
  enrollments        Enrollment[]
  teacherSubjects    TeacherSubject[]
  attendance         AttendanceRecord[]
  calendarExceptions CalendarException[]
  timetableSlots     TimetableSlot[]
  studentMarks       StudentMark[]
  reportCards        ReportCard[]
  feeInvoices        FeeInvoice[]
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  isLocked       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendance         AttendanceRecord[]
  calendarExceptions CalendarException[]
  enrollments        Enrollment[]
  timetableSlots     TimetableSlot[]
  studentMarks       StudentMark[]
  reportCards        ReportCard[]
  feeInvoices        FeeInvoice[]

  @@unique([academicYearId, termNumber])
}

/// Holidays / closures (CLOSED) or special open days e.g. Saturday makeup (OPEN).
/// Always attached to a term so dates stay within that term’s window.
model CalendarException {
  id             String          @id @default(cuid())
  academicYearId String?
  academicYear   AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?           @relation(fields: [termId], references: [id], onDelete: Cascade)
  date           DateTime        @db.Date
  type           CalendarDayType @default(CLOSED)
  name           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([date])
  @@index([academicYearId, date])
  @@index([termId, date])
}

model Stage {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gradeLevels        GradeLevel[]
  subjects           Subject[]
  activities         Activity[]
  assessmentScheme   AssessmentScheme?
  gradeBands         GradeBand[]
}

model GradeLevel {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSections   ClassSection[]
  subjectLevels   SubjectLevel[]
  activityLevels  ActivityLevel[]

  @@index([stageId])
}

model ClassSection {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeLevelId   String
  gradeLevel     GradeLevel   @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  name           String
  section        String?
  classTeacherId String?
  classTeacher   Staff?       @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  room           String?
  capacity       Int?
  /// Soft-archive. Never hard-delete when students (current/historical) reference it.
  isActive       Boolean      @default(true)
  /// Class copied from a previous year's class during year rollover.
  copiedFromId   String?
  copiedFrom     ClassSection?  @relation("ClassCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies         ClassSection[] @relation("ClassCopy")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  currentStudents Student[]         @relation("CurrentClass")
  enrollments     Enrollment[]
  teacherSubjects TeacherSubject[]
  announcements   Announcement[]
  attendance      AttendanceRecord[]
  timetableSlots  TimetableSlot[]
  studentMarks    StudentMark[]
  reportCards     ReportCard[]

  @@unique([academicYearId, gradeLevelId, name])
  @@index([academicYearId, isActive])
}

model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  isCore    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherSubjects TeacherSubject[]
  allowedLevels   SubjectLevel[]
  timetableSlots  TimetableSlot[]
  studentMarks    StudentMark[]

  @@index([stageId])
}

/// Restrict a subject to specific grade levels. Empty = all levels in the subject's stage.
model SubjectLevel {
  id           String     @id @default(cuid())
  subjectId    String
  gradeLevelId String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, gradeLevelId])
  @@index([gradeLevelId])
}

model TeacherSubject {
  id             String       @id @default(cuid())
  staffId        String
  subjectId      String
  classSectionId String
  academicYearId String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId, classSectionId, academicYearId])
  @@unique([subjectId, classSectionId, academicYearId])
  @@index([classSectionId, academicYearId])
}

/// School activity catalog (Break, Lunch, Worship, etc.). Scoped like subjects.
model Activity {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allowedLevels  ActivityLevel[]
  timetableSlots TimetableSlot[]

  @@index([stageId])
}

/// Restrict an activity to specific grade levels. Empty = all levels in the activity's stage.
model ActivityLevel {
  id           String     @id @default(cuid())
  activityId   String
  gradeLevelId String
  activity     Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([activityId, gradeLevelId])
  @@index([gradeLevelId])
}

/// Weekly class timetable slot (day + start/end time). Subject XOR activity; overlaps blocked in API.
model TimetableSlot {
  id             String       @id @default(cuid())
  academicYearId String
  termId         String
  classSectionId String
  subjectId      String?
  activityId     String?
  staffId        String?
  /// 1 = Monday … 5 = Friday
  dayOfWeek      Int
  startTime      DateTime     @db.Time
  endTime        DateTime     @db.Time
  room           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  activity     Activity?    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([classSectionId, termId, dayOfWeek])
  @@index([staffId, termId, dayOfWeek])
  @@index([academicYearId, termId])
  @@index([activityId])
  @@index([subjectId])
}

/// Placement history. A student may have many rows per year (mid-year transfers).
/// Current row has isCurrent=true and endedOn=null. Past rows are archived.
model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  classSectionId String
  academicYearId String
  termId         String?
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  status         EnrollmentStatus @default(ENROLLED)
  reason         String?
  startedOn      DateTime         @default(now())
  endedOn        DateTime?
  isCurrent      Boolean          @default(true)
  enrolledOn     DateTime         @default(now())

  @@index([studentId, academicYearId])
  @@index([studentId, isCurrent])
  @@index([classSectionId])
  @@index([termId])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  remark         String?
  markedById     String?
  markedBy       Staff?           @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([studentId, classSectionId, date])
  @@index([classSectionId, date])
  @@index([termId, classSectionId])
  @@index([date])
}

model Announcement {
  id              String        @id @default(cuid())
  title           String
  body            String
  createdByUserId String
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  audience        String        @default("all")
  classSectionId  String?
  classSection    ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  publishedAt     DateTime      @default(now())
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  relatedType String?
  relatedId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

/// CA / exam weight scheme per stage (e.g. Primary 30/70).
model AssessmentScheme {
  id               String   @id @default(cuid())
  stageId          String   @unique
  stage            Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  classScoreWeight Float    @default(30)
  examWeight       Float    @default(70)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Letter grade bands for a stage (A 80–100, …).
model GradeBand {
  id        String   @id @default(cuid())
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  label     String
  minScore  Float
  maxScore  Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stageId, label])
  @@index([stageId, sortOrder])
}

model StudentMark {
  id             String       @id @default(cuid())
  studentId      String
  subjectId      String
  classSectionId String
  academicYearId String
  termId         String
  classScore     Float?
  examScore      Float?
  total          Float?
  gradeLabel     String?
  remark         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, classSectionId, termId])
  @@index([classSectionId, termId, subjectId])
  @@index([studentId, termId])
}

model ReportCard {
  id             String       @id @default(cuid())
  studentId      String
  classSectionId String
  academicYearId String
  termId         String
  teacherRemark  String?
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([classSectionId, termId])
}

model FeeType {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  defaultAmount Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices FeeInvoice[]
}

model FeeInvoice {
  id             String           @id @default(cuid())
  studentId      String
  feeTypeId      String
  academicYearId String
  termId         String?
  amount         Float
  dueDate        DateTime?
  status         FeeInvoiceStatus @default(OPEN)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeType      FeeType       @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?         @relation(fields: [termId], references: [id], onDelete: SetNull)
  payments     FeePayment[]

  @@index([studentId, academicYearId])
  @@index([status])
  @@index([feeTypeId])
}

model FeePayment {
  id               String           @id @default(cuid())
  invoiceId        String
  amount           Float
  method           FeePaymentMethod @default(CASH)
  paidOn           DateTime         @default(now())
  reference        String?
  receivedByUserId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy User?      @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidOn])
}
